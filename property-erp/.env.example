# ===== قاعدة البيانات / Database =====
DATABASE_URL="postgresql://gsw:CHANGE_ME@localhost:5432/gsw_erp?schema=public"
# قاعدة بيانات الاختبارات المنفصلة (تُمسح بالكامل أثناء الاختبارات)
TEST_DATABASE_URL="postgresql://gsw:CHANGE_ME@localhost:5432/gsw_erp_test?schema=public"

# ===== الأمان / Security =====
# مفتاح عشوائي طويل (32 بايت على الأقل) لتوقيع روابط الملفات المؤقتة
# أنشئه بالأمر: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
# الرابط العام للتطبيق (يُستخدم للتحقق من مصدر الطلبات CSRF)
APP_URL="http://localhost:3000"
# اجعلها true في الإنتاج خلف HTTPS
COOKIE_SECURE="false"
# مدة الجلسة بالساعات
SESSION_TTL_HOURS="12"

# ===== التخزين / Storage =====
# مجلد خاص خارج public لحفظ المرفقات
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="15"

# ===== النسخ الاحتياطي / Backups =====
BACKUP_DIR="./backups"
# عبارة مرور التشفير للنسخ الاحتياطية (AES-256) — احفظها في مكان آمن منفصل
BACKUP_PASSPHRASE="CHANGE_ME"

# ===== تكاملات خارجية (غير مفعلة افتراضيًا) =====
# لا تعمل أي قناة قبل ربط مزود حقيقي واختباره
EMAIL_PROVIDER=""
SMTP_URL=""
WHATSAPP_PROVIDER=""
SMS_PROVIDER=""
AI_PROVIDER=""
AI_API_KEY=""
# تفعيل صفحة التهيئة عبر المتصفح لمرة واحدة (اتركه فارغًا لاستخدام سطر الأوامر فقط)
SETUP_TOKEN=""
