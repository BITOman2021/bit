# Copy to .env  (never commit .env). No paid API key is needed or used.
POSTGRES_PASSWORD=change-me-long-random
ACS_SECRET_KEY=change-me-64-random-chars        # e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
ACS_PUBLIC_URL=http://localhost
ACS_HTTP_PORT=80
ACS_ALLOW_REGISTRATION=true                      # first registered user becomes admin; then you may set false
ACS_LOW_RESOURCE=false                           # true caps image size/steps/count and video quality
# External AI servers (optional). Defaults assume they run on the Docker host.
ACS_COMFYUI_URL=http://host.docker.internal:8188
ACS_OLLAMA_URL=http://host.docker.internal:11434
